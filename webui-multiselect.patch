+import * as React from 'react';
+import { useTranslation } from 'react-i18next';
+
+import Button from '@/components/semantic/Button';
+import IconConstants from '@/constants/IconConstants';
+
+import { toI18nKey, translate } from '@/utils/TranslationUtils';
+import * as UI from '@/types/ui';
+
+import { TableSelectionItem } from './TableSelectionStore';
+import { useSelectedItems, useTableSelectionStore } from './TableSelectionContext';
+
+import './style.css';
+
+export interface SelectionBarProps {
+  // Displays a download button (downloads to the default directory) when set
+  onDownload?: () => void;
+
+  // Displays a button for choosing the download directory when set
+  onDownloadTo?: () => void;
+
+  // Additional actions (displayed after the download button)
+  children?: React.ReactNode;
+}
+
+// Table footer content that is displayed when there are selected rows
+export const SelectionBar: React.FC<SelectionBarProps> = ({
+  onDownload,
+  onDownloadTo,
+  children,
+}) => {
+  const { t } = useTranslation();
+  const store = useTableSelectionStore<TableSelectionItem>();
+  const selected = useSelectedItems();
+
+  if (selected.length === 0) {
+    return null;
+  }
+
+  return (
+    <div className="table-selection-bar">
+      <span className="selection-count">
+        {t(toI18nKey('selectedCount', UI.Modules.COMMON), {
+          defaultValue: '{{count}} selected',
+          replace: { count: selected.length },
+        })}
+      </span>
+      {!!onDownload && (
+        <Button
+          className="tiny"
+          icon={IconConstants.DOWNLOAD}
+          caption={translate('Download', t, UI.Modules.COMMON)}
+          onClick={onDownload}
+        />
+      )}
+      {!!onDownloadTo && (
+        <Button
+          className="tiny"
+          icon={IconConstants.FOLDER}
+          caption={translate('Download to...', t, UI.Modules.COMMON)}
+          onClick={onDownloadTo}
+        />
+      )}
+      {children}
+      <Button
+        className="tiny basic"
+        icon={IconConstants.CLEAR}
+        caption={translate('Clear selection', t, UI.Modules.COMMON)}
+        onClick={store.clear}
+      />
+    </div>
+  );
+};
