+import QueueConstants from '@/constants/QueueConstants';
+import IconConstants from '@/constants/IconConstants';
+import { PriorityEnum } from '@/constants/PriorityConstants';
+
+import * as API from '@/types/api';
+import * as UI from '@/types/ui';
+
+import { APISocket } from '@/services/SocketService';
+import { setBundlePriority } from '@/services/api/QueueApi';
+import { TableSelectionStore } from '@/components/table/selection';
+
+// Actions for the bundles selected in the queue table (bulk actions)
+
+export interface QueueBundleSelectionData {
+  // Required for menu item data
+  id: string;
+
+  // Description of the selection (e.g. "3 bundles"), used in confirmations and notifications
+  name: string;
+
+  bundles: API.QueueBundle[];
+  selection: TableSelectionStore<API.QueueBundle>;
+}
+
+type Handler = UI.ActionHandler<QueueBundleSelectionData>;
+type Filter = UI.ActionFilter<QueueBundleSelectionData>;
+
+const isUnfinished = (bundle: API.QueueBundle) => bundle.time_finished === 0;
+
+const hasUnfinished: Filter = ({ itemData }) => itemData.bundles.some(isUnfinished);
+
+// Runs the task for each of the bundles. Bundles that were handled successfully are removed
+// from the selection so that a failed action can be retried for the remaining ones.
+const runForBundles = async (
+  { bundles, selection }: QueueBundleSelectionData,
+  task: (bundle: API.QueueBundle) => Promise<unknown>,
+) => {
+  const failures: { bundle: API.QueueBundle; error: Error }[] = [];
+
+  for (const bundle of bundles) {
+    try {
+      await task(bundle);
+      selection.setSelected(bundle, false);
+    } catch (e) {
+      failures.push({ bundle, error: e as Error });
+    }
+  }
+
+  if (failures.length > 0) {
+    const names = failures.map(({ bundle }) => bundle.name).join(', ');
+    throw new Error(
+      `Failed for ${failures.length}/${bundles.length} bundles (${names}): ${failures[0].error.message}`,
+    );
+  }
+};
+
+const removeBundle = (
+  socket: APISocket,
+  bundle: API.QueueBundle,
+  removeFinished: boolean,
+) => {
+  return socket.post(`${QueueConstants.BUNDLES_URL}/${bundle.id}/remove`, {
+    remove_finished: removeFinished,
+  });
+};
+
+const handleRemove: Handler = ({ itemData, socket }, removeFinished) => {
+  return runForBundles(itemData, (bundle) =>
+    removeBundle(socket, bundle, removeFinished === true),
+  );
+};
+
+const handleSearchAlternates: Handler = ({ itemData, socket }) => {
+  return runForBundles(
+    { ...itemData, bundles: itemData.bundles.filter(isUnfinished) },
+    (bundle) => socket.post(`${QueueConstants.BUNDLES_URL}/${bundle.id}/search`),
+  );
+};
+
+const createPriorityHandler = (priority: API.QueuePriorityEnum): Handler => {
+  return ({ itemData, socket }) => {
+    // Priorities can't be changed for finished bundles
+    return runForBundles(
+      { ...itemData, bundles: itemData.bundles.filter(isUnfinished) },
+      (bundle) => setBundlePriority(bundle, priority, socket),
+    );
+  };
+};
+
+export const QueueBundleSelectionRemoveAction = {
+  id: 'removeSelected',
+  displayName: 'Remove selected bundles',
+  access: API.AccessEnum.QUEUE_EDIT,
+  icon: IconConstants.REMOVE,
+  confirmation: {
+    content: 'Are you sure that you want to remove {{item.name}}?',
+    approveCaption: 'Remove bundles',
+    rejectCaption: `Don't remove`,
+    checkboxCaption: 'Remove finished files',
+  },
+  handler: handleRemove,
+  notifications: {
+    onSuccess: '{{item.name}} were removed',
+  },
+};
+
+export const QueueBundleSelectionSearchAlternatesAction = {
+  id: 'searchAlternatesSelected',
+  displayName: 'Search alternates for selected',
+  access: API.AccessEnum.QUEUE_EDIT,
+  icon: IconConstants.SEARCH_ALTERNATES,
+  filter: hasUnfinished,
+  handler: handleSearchAlternates,
+  notifications: {
+    onSuccess: '{{item.name}} were searched for alternates',
+  },
+};
+
+const createPriorityAction = (
+  id: string,
+  displayName: string,
+  priority: API.QueuePriorityEnum,
+): UI.ActionDefinition<QueueBundleSelectionData> => ({
+  id,
+  displayName,
+  access: API.AccessEnum.QUEUE_EDIT,
+  filter: hasUnfinished,
+  handler: createPriorityHandler(priority),
+});
+
+// Same priorities as in the priority menu of the table (highest first)
+const priorityActions: UI.ChildActionListType<QueueBundleSelectionData, void> = {};
+Object.keys(PriorityEnum)
+  .map(Number)
+  .sort((a, b) => b - a)
+  .forEach((priorityId) => {
+    priorityActions[`priority${priorityId}`] = createPriorityAction(
+      `priority${priorityId}`,
+      PriorityEnum[priorityId as keyof typeof PriorityEnum].str,
+      priorityId,
+    );
+  });
+
+priorityActions.priorityAuto = createPriorityAction(
+  'priorityAuto',
+  'Auto',
+  API.QueuePriorityEnum.DEFAULT,
+);
+
+const QueueBundleSelectionActions: UI.ActionListType<QueueBundleSelectionData> = {
+  priority: {
+    id: 'priority',
+    displayName: 'Set priority of selected',
+    icon: IconConstants.SETTINGS,
+    children: priorityActions,
+  },
+  searchAlternates: QueueBundleSelectionSearchAlternatesAction,
+  divider: null,
+  remove: QueueBundleSelectionRemoveAction,
+};
+
+export const QueueBundleSelectionActionModule = {
+  moduleId: UI.Modules.QUEUE,
+  subId: 'selection',
+};
+
+export const QueueBundleSelectionActionMenu = {
+  moduleData: QueueBundleSelectionActionModule,
+  actions: QueueBundleSelectionActions,
+} as UI.ModuleActions<QueueBundleSelectionData>;
diff --git a/src/actions/ui/queue/__tests__/QueueBundleSelectionActions.node.test.ts b/src/actions/ui/queue/__tests__/QueueBundleSelectionActions.node.test.ts
new file mode 100644
index 0000000..2e77c8c
--- /dev/null
+++ b/src/actions/ui/queue/__tests__/QueueBundleSelectionActions.node.test.ts
@@ -0,0 +1,175 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import * as API from '@/types/api';
+import * as UI from '@/types/ui';
+import { TableSelectionStore } from '@/components/table/selection';
+
+import {
+  QueueBundleSelectionActionMenu,
+  QueueBundleSelectionData,
+  QueueBundleSelectionRemoveAction,
+  QueueBundleSelectionSearchAlternatesAction,
+} from '../QueueBundleSelectionActions';
+
+const createBundle = (id: number, finished: boolean): API.QueueBundle =>
+  ({
+    id,
+    name: `bundle${id}`,
+    time_finished: finished ? 1000 : 0,
+  }) as API.QueueBundle;
+
+const active1 = createBundle(1, false);
+const active2 = createBundle(2, false);
+const finished = createBundle(3, true);
+
+const createData = (bundles: API.QueueBundle[]) => {
+  const selection = new TableSelectionStore<API.QueueBundle>();
+  bundles.forEach((bundle) => selection.setSelected(bundle, true));
+
+  const data: QueueBundleSelectionData = {
+    id: 'selection',
+    name: `${bundles.length} bundles`,
+    bundles,
+    selection,
+  };
+
+  return { data, selection };
+};
+
+const createSocket = (failIds: number[] = []) => ({
+  post: vi.fn(async (url: string, _body?: unknown) => {
+    const id = Number(url.split('/')[2]);
+    if (failIds.includes(id)) {
+      throw new Error('failed');
+    }
+  }),
+});
+
+const run = (
+  action: UI.ActionDefinition<QueueBundleSelectionData>,
+  data: QueueBundleSelectionData,
+  socket: ReturnType<typeof createSocket>,
+  confirmData?: boolean,
+) => action.handler({ itemData: data, socket, entity: undefined } as any, confirmData);
+
+const priorityChildren = (
+  QueueBundleSelectionActionMenu.actions.priority as UI.GroupedActionDefition<
+    QueueBundleSelectionData,
+    void
+  >
+).children;
+
+describe('queue bundle selection actions', () => {
+  describe('remove', () => {
+    it('removes all selected bundles and clears the selection', async () => {
+      const { data, selection } = createData([active1, finished]);
+      const socket = createSocket();
+
+      await run(QueueBundleSelectionRemoveAction, data, socket, false);
+
+      expect(socket.post.mock.calls).toEqual([
+        ['queue/bundles/1/remove', { remove_finished: false }],
+        ['queue/bundles/3/remove', { remove_finished: false }],
+      ]);
+      expect(selection.getItems()).toEqual([]);
+    });
+
+    it('passes the finished files option', async () => {
+      const { data } = createData([active1]);
+      const socket = createSocket();
+
+      await run(QueueBundleSelectionRemoveAction, data, socket, true);
+      expect(socket.post).toHaveBeenCalledWith('queue/bundles/1/remove', {
+        remove_finished: true,
+      });
+    });
+
+    it('keeps the failed bundles selected and reports them', async () => {
+      const { data, selection } = createData([active1, active2, finished]);
+      const socket = createSocket([2]);
+
+      await expect(
+        run(QueueBundleSelectionRemoveAction, data, socket, false),
+      ).rejects.toThrow('Failed for 1/3 bundles (bundle2): failed');
+
+      expect(socket.post).toHaveBeenCalledTimes(3);
+      expect(selection.getItems()).toEqual([active2]);
+    });
+  });
+
+  describe('priority', () => {
+    it('sets the priority only for unfinished bundles', async () => {
+      const { data, selection } = createData([active1, finished, active2]);
+      const socket = createSocket();
+
+      await run(priorityChildren.priority6 as UI.ActionDefinition<any>, data, socket);
+
+      expect(socket.post.mock.calls).toEqual([
+        ['queue/bundles/1/priority', { priority: API.QueuePriorityEnum.HIGHEST }],
+        ['queue/bundles/2/priority', { priority: API.QueuePriorityEnum.HIGHEST }],
+      ]);
+
+      // The finished bundle wasn't handled, so it stays selected
+      expect(selection.getItems()).toEqual([finished]);
+    });
+
+    it('supports the auto priority and pausing', async () => {
+      const { data } = createData([active1]);
+      const socket = createSocket();
+
+      await run(priorityChildren.priorityAuto as UI.ActionDefinition<any>, data, socket);
+      await run(priorityChildren.priority0 as UI.ActionDefinition<any>, data, socket);
+
+      expect(socket.post.mock.calls.map(([, body]) => body)).toEqual([
+        { priority: API.QueuePriorityEnum.DEFAULT },
+        { priority: API.QueuePriorityEnum.PAUSED_FORCED },
+      ]);
+    });
+
+    it('lists the priorities from highest to lowest, followed by auto', () => {
+      expect(Object.keys(priorityChildren)).toEqual([
+        'priority6',
+        'priority5',
+        'priority4',
+        'priority3',
+        'priority2',
+        'priority1',
+        'priority0',
+        'priorityAuto',
+      ]);
+    });
+
+    it('is hidden when only finished bundles are selected', () => {
+      const action = priorityChildren.priority4 as UI.ActionDefinition<any>;
+      expect(
+        action.filter!({ itemData: createData([finished]).data, entity: undefined }),
+      ).toBe(false);
+      expect(
+        action.filter!({
+          itemData: createData([finished, active1]).data,
+          entity: undefined,
+        }),
+      ).toBe(true);
+    });
+  });
+
+  describe('search for alternates', () => {
+    it('searches only the unfinished bundles', async () => {
+      const { data } = createData([active1, finished]);
+      const socket = createSocket();
+
+      await run(QueueBundleSelectionSearchAlternatesAction, data, socket);
+      expect(socket.post.mock.calls).toEqual([['queue/bundles/1/search']]);
+    });
+  });
+
+  it('requires queue edit access for all actions', () => {
+    expect(QueueBundleSelectionRemoveAction.access).toBe(API.AccessEnum.QUEUE_EDIT);
+    expect(QueueBundleSelectionSearchAlternatesAction.access).toBe(
+      API.AccessEnum.QUEUE_EDIT,
+    );
+    Object.values(priorityChildren).forEach((action) =>
+      expect((action as UI.ActionDefinition<any>).access).toBe(API.AccessEnum.QUEUE_EDIT),
+    );
+  });
+});
