+import IconConstants from '@/constants/IconConstants';
+
+import * as UI from '@/types/ui';
+
+// Actions for the search results selected in the result table
+
+export interface SearchSelectionData {
+  // Required for menu item data
+  id: string;
+
+  // Description of the selection (e.g. "3 results")
+  name: string;
+
+  // Download to the default directory
+  download: () => Promise<unknown>;
+
+  // Open the download dialog for choosing the directory
+  downloadTo: () => void;
+}
+
+type Handler = UI.ActionHandler<SearchSelectionData>;
+
+const handleDownload: Handler = ({ itemData }) => itemData.download();
+
+const handleDownloadTo: Handler = ({ itemData }) => {
+  itemData.downloadTo();
+};
+
+export const SearchSelectionDownloadAction = {
+  id: 'downloadSelected',
+  displayName: 'Download selected',
+  icon: IconConstants.DOWNLOAD,
+  handler: handleDownload,
+};
+
+export const SearchSelectionDownloadToAction = {
+  id: 'downloadSelectedTo',
+  displayName: 'Download selected to...',
+  icon: IconConstants.FOLDER,
+  handler: handleDownloadTo,
+};
+
+const SearchSelectionActions: UI.ActionListType<SearchSelectionData> = {
+  download: SearchSelectionDownloadAction,
+  downloadTo: SearchSelectionDownloadToAction,
+};
+
+export const SearchSelectionActionModule = {
+  moduleId: UI.Modules.SEARCH,
+  subId: 'selection',
+};
+
+export const SearchSelectionActionMenu = {
+  moduleData: SearchSelectionActionModule,
+  actions: SearchSelectionActions,
+} as UI.ModuleActions<SearchSelectionData>;
