+.virtual-table .cell-wrapper .table-select-checkbox {
+  display: block;
+  width: 18px;
+  height: 18px;
+  margin: 0px 0px 0px 6px;
+  cursor: pointer;
+}
+
+.table-footer .table-selection-bar {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.table-footer .table-selection-bar .selection-count {
+  font-weight: bold;
+  white-space: nowrap;
+}
+
+.table-footer .table-selection-bar .ui.button {
+  margin: 0px;
+}
+
+/* Select all checkbox in the table header.
+   The table's header <Cell> already centers its content vertically and adds 8px of padding,
+   unlike the row cells (cell-wrapper has 5px of padding + 6px margin = 11px from the cell edge).
+   The 3px margin makes the checkbox line up with the row checkboxes. */
+.table-select-all .table-select-checkbox {
+  display: block;
+  width: 18px;
+  height: 18px;
+  margin: 0px 0px 0px 3px;
+  cursor: pointer;
+}
+
+/* Space between the other footer content and the selection bar */
+.table-footer > * + .table-selection-bar {
+  margin-left: 12px;
+}
