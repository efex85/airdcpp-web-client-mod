+import * as React from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { translate } from '@/utils/TranslationUtils';
+import * as UI from '@/types/ui';
+
+import { TableSelectionItem } from './TableSelectionStore';
+import { useIsRowSelected, useTableSelectionStore } from './TableSelectionContext';
+
+import './style.css';
+
+export interface SelectCellProps<ItemT extends TableSelectionItem> {
+  // Provided by RowWrapperCell
+  rowDataGetter?: () => ItemT;
+}
+
+// Checkbox cell for selecting table rows (to be used with TableSelectionProvider)
+export const SelectCell = <ItemT extends TableSelectionItem & { name?: string }>({
+  rowDataGetter,
+}: SelectCellProps<ItemT>) => {
+  const { t } = useTranslation();
+  const store = useTableSelectionStore<ItemT>();
+
+  const item = rowDataGetter!();
+  const checked = useIsRowSelected(item.id);
+
+  return (
+    <input
+      type="checkbox"
+      className="table-select-checkbox"
+      checked={checked}
+      aria-label={`${translate('Select', t, UI.Modules.COMMON)} ${item.name ?? ''}`.trim()}
+      onChange={(evt) => store.setSelected(item, evt.target.checked)}
+    />
+  );
+};
