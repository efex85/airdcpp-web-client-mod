@@ -0,0 +1,120 @@
+import * as React from 'react';
+import { useNavigate } from 'react-router';
+import { useTranslation } from 'react-i18next';
+
+import * as API from '@/types/api';
+import * as UI from '@/types/ui';
+import { toI18nKey } from '@/utils/TranslationUtils';
+
+import NotificationActions from '@/actions/NotificationActions';
+import { useSocket } from '@/context/SocketContext';
+import { TableSelectionStore } from '@/components/table/selection';
+
+import {
+  BULK_DOWNLOAD_ITEM_ID,
+  createBulkDownloadHandler,
+  createBulkDownloadItem,
+  isBulkDownloadRouteId,
+} from './BulkDownload';
+
+interface UseBulkDownloadProps<ItemT extends UI.DownloadableItemInfo> {
+  selection: TableSelectionStore<ItemT>;
+
+  // Handler for a single item
+  downloadHandler: UI.DownloadHandler<ItemT>;
+
+  // Getter for a single item
+  itemDataGetter: UI.DownloadItemDataGetter<ItemT>;
+
+  // Passed to the download handler by the direct download
+  // (the same values that are given to the download dialog)
+  entity?: UI.SessionItemBase;
+  user?: UI.DownloadSource;
+}
+
+// Adds support for downloading all selected items.
+//
+// - startDownload queues the items right away without a target directory
+//   (the default download directory of the application is used)
+// - startDownloadTo opens the regular download dialog for choosing the target directory.
+//   Pass the returned handler and getter to the DownloadDialog (in a route that is
+//   a parent of the 'download/:id' route) for this.
+export const useBulkDownload = <ItemT extends UI.DownloadableItemInfo>({
+  selection,
+  downloadHandler,
+  itemDataGetter,
+  entity,
+  user,
+}: UseBulkDownloadProps<ItemT>) => {
+  const { t } = useTranslation();
+  const navigate = useNavigate();
+  const socket = useSocket();
+
+  const bulkDownloadHandler = React.useMemo(
+    () => createBulkDownloadHandler(selection, downloadHandler),
+    [selection, downloadHandler],
+  );
+
+  const getItemCountCaption = (count: number) =>
+    t(toI18nKey('itemCount', UI.Modules.COMMON), {
+      defaultValue_one: '{{count}} item',
+      defaultValue_other: '{{count}} items',
+      count,
+      replace: { count },
+    });
+
+  const bulkItemDataGetter: UI.DownloadItemDataGetter<ItemT> = (itemId, socket) => {
+    if (isBulkDownloadRouteId(itemId)) {
+      const items = selection.getItems();
+      return Promise.resolve(
+        createBulkDownloadItem<ItemT>(items, getItemCountCaption(items.length)),
+      );
+    }
+
+    return itemDataGetter(itemId, socket);
+  };
+
+  const startDownloadTo = () => navigate(`download/${BULK_DOWNLOAD_ITEM_ID}`);
+
+  // Items that were queued successfully are removed from the selection (by the handler)
+  // so failed ones can be retried
+  const startDownload = async () => {
+    const items = selection.getItems();
+    if (items.length === 0) {
+      return;
+    }
+
+    const caption = getItemCountCaption(items.length);
+    const placeholder = createBulkDownloadItem<ItemT>(items, caption);
+
+    try {
+      await bulkDownloadHandler(
+        { itemInfo: placeholder, user, entity },
+        // No target directory
+        { target_name: placeholder.name, priority: API.QueuePriorityEnum.DEFAULT },
+        socket,
+      );
+
+      NotificationActions.info({
+        title: t(toI18nKey('bulkQueued', UI.Modules.COMMON), {
+          defaultValue: '{{items}} queued for download',
+          replace: { items: caption },
+        }),
+      });
+    } catch (e) {
+      NotificationActions.error({
+        title: t(toI18nKey('bulkQueueingFailed', UI.Modules.COMMON), {
+          defaultValue: 'Failed to queue the selected items',
+        }),
+        message: (e as Error).message,
+      });
+    }
+  };
+
+  return {
+    downloadHandler: bulkDownloadHandler,
+    itemDataGetter: bulkItemDataGetter,
+    startDownload,
+    startDownloadTo,
+  };
+};
