@@ -0,0 +1,40 @@
+import * as React from 'react';
+
+import {
+  SelectionKey,
+  TableSelectionItem,
+  TableSelectionStore,
+} from './TableSelectionStore';
+
+const TableSelectionContext = React.createContext<TableSelectionStore<any> | null>(null);
+
+export const TableSelectionProvider = <ItemT extends TableSelectionItem>({
+  store,
+  children,
+}: React.PropsWithChildren<{ store: TableSelectionStore<ItemT> }>) => (
+  <TableSelectionContext value={store}>{children}</TableSelectionContext>
+);
+
+export const useTableSelectionStore = <
+  ItemT extends TableSelectionItem,
+>(): TableSelectionStore<ItemT> => {
+  const store = React.use(TableSelectionContext);
+  if (!store) {
+    throw new Error('Table selection store is missing (TableSelectionProvider)');
+  }
+
+  return store;
+};
+
+// Re-renders only when the selection state of the given row changes
+export const useIsRowSelected = (id: SelectionKey) => {
+  const store = useTableSelectionStore();
+  return React.useSyncExternalStore(store.subscribe, () => store.isSelected(id));
+};
+
+// Re-renders whenever the selection changes
+export const useSelectedItems = <ItemT extends TableSelectionItem>() => {
+  const store = useTableSelectionStore<ItemT>();
+  const selected = React.useSyncExternalStore(store.subscribe, store.getSnapshot);
+  return React.useMemo(() => Array.from(selected.values()), [selected]);
+};
diff --git a/src/components/table/selection/TableSelectionStore.ts b/src/components/table/selection/TableSelectionStore.ts
new file mode 100644
index 0000000..b94a00c
--- /dev/null
+++ b/src/components/table/selection/TableSelectionStore.ts
@@ -0,0 +1,77 @@
+// Small external store for row selection in virtualized tables.
+//
+// Rows are loaded lazily and table cells are recycled, so the selection can't live in
+// the row components. The store keeps a snapshot of every selected item (not just the
+// IDs) so that bulk actions don't depend on the rows being loaded at the time.
+
+export type SelectionKey = string | number;
+
+export interface TableSelectionItem {
+  id: SelectionKey;
+}
+
+export class TableSelectionStore<ItemT extends TableSelectionItem> {
+  private selected: ReadonlyMap<SelectionKey, ItemT> = new Map();
+  private readonly listeners = new Set<() => void>();
+
+  // Increased every time the selection is cleared. Asynchronous operations (such as
+  // selecting all rows) can use this to detect that their result is outdated.
+  private generation = 0;
+
+  // Arrow functions so that these can be passed directly to useSyncExternalStore
+  subscribe = (listener: () => void) => {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  };
+
+  // The returned map is never mutated (a new one is created on every change)
+  getSnapshot = (): ReadonlyMap<SelectionKey, ItemT> => this.selected;
+
+  getGeneration = () => this.generation;
+
+  isSelected = (id: SelectionKey) => this.selected.has(id);
+
+  getItems = (): ItemT[] => Array.from(this.selected.values());
+
+  setSelected = (item: ItemT, checked: boolean) => {
+    if (this.selected.has(item.id) === checked) {
+      return;
+    }
+
+    const next = new Map(this.selected);
+    if (checked) {
+      next.set(item.id, item);
+    } else {
+      next.delete(item.id);
+    }
+
+    this.update(next);
+  };
+
+  // Adds all items to the selection with a single change notification
+  setManySelected = (items: ItemT[]) => {
+    const next = new Map(this.selected);
+    items.forEach((item) => next.set(item.id, item));
+    if (next.size === this.selected.size) {
+      return;
+    }
+
+    this.update(next);
+  };
+
+  clear = () => {
+    this.generation++;
+    if (this.selected.size === 0) {
+      return;
+    }
+
+    this.update(new Map());
+  };
+
+  private update(next: ReadonlyMap<SelectionKey, ItemT>) {
+    this.selected = next;
+    this.listeners.forEach((listener) => listener());
+  }
+}
