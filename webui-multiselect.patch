+++ b/src/components/table/selection/__tests__/SelectAllHeaderCell.node.test.tsx
@@ -0,0 +1,165 @@
+import * as React from 'react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { act, cleanup, render, screen, waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+
+import { SocketContext } from '@/context/SocketContext';
+
+import { SelectAllHeaderCell, SelectableViewStore } from '../SelectAllHeaderCell';
+import { TableSelectionProvider } from '../TableSelectionContext';
+import { TableSelectionStore } from '../TableSelectionStore';
+
+interface Item {
+  id: number;
+  name: string;
+}
+
+const createRows = (count: number): Item[] =>
+  Array.from({ length: count }, (_, i) => ({ id: i + 1, name: `item${i + 1}` }));
+
+// Minimal stand-in for a Reflux view store
+const createViewStore = (
+  rowCount: number,
+): SelectableViewStore & { notify: () => void } => {
+  const listeners = new Set<() => void>();
+  const store = {
+    rowCount,
+    viewUrl: 'filelists/session1/filelist_view',
+    listen: (listener: () => void) => {
+      listeners.add(listener);
+      return () => listeners.delete(listener);
+    },
+    notify: () => listeners.forEach((l) => l()),
+  };
+  return store;
+};
+
+const createSocket = (rows: Item[]) => ({
+  get: vi.fn(async (url: string) => {
+    const [, , , , start, end] = url.split('/');
+    return rows.slice(Number(start), Number(end));
+  }),
+});
+
+const renderHeader = (
+  selection: TableSelectionStore<Item>,
+  viewStore: SelectableViewStore,
+  socket: ReturnType<typeof createSocket>,
+) =>
+  render(
+    <SocketContext value={socket as any}>
+      <TableSelectionProvider store={selection}>
+        <SelectAllHeaderCell viewStore={viewStore} />
+      </TableSelectionProvider>
+    </SocketContext>,
+  );
+
+afterEach(() => cleanup());
+
+describe('SelectAllHeaderCell', () => {
+  it('selects all rows of the view (also the ones that are not loaded)', async () => {
+    const rows = createRows(250);
+    const selection = new TableSelectionStore<Item>();
+    const socket = createSocket(rows);
+    renderHeader(selection, createViewStore(250), socket);
+
+    const checkbox = screen.getByRole('checkbox') as HTMLInputElement;
+    expect(checkbox.checked).toBe(false);
+
+    await userEvent.click(checkbox);
+    await waitFor(() => expect(selection.getItems()).toHaveLength(250));
+
+    // Fetched in chunks
+    expect(socket.get.mock.calls.map(([url]) => url)).toEqual([
+      'filelists/session1/filelist_view/items/0/100',
+      'filelists/session1/filelist_view/items/100/200',
+      'filelists/session1/filelist_view/items/200/250',
+    ]);
+    expect(selection.getItems()).toEqual(rows);
+    await waitFor(() => expect(checkbox.checked).toBe(true));
+  });
+
+  it('deselects everything when all rows are selected', async () => {
+    const rows = createRows(5);
+    const selection = new TableSelectionStore<Item>();
+    selection.setManySelected(rows);
+
+    const socket = createSocket(rows);
+    renderHeader(selection, createViewStore(5), socket);
+
+    const checkbox = screen.getByRole('checkbox') as HTMLInputElement;
+    expect(checkbox.checked).toBe(true);
+
+    await userEvent.click(checkbox);
+    expect(selection.getItems()).toEqual([]);
+    expect(socket.get).not.toHaveBeenCalled();
+    expect(checkbox.checked).toBe(false);
+  });
+
+  it('shows the indeterminate state for a partial selection and completes it on click', async () => {
+    const rows = createRows(5);
+    const selection = new TableSelectionStore<Item>();
+    selection.setSelected(rows[0], true);
+
+    renderHeader(selection, createViewStore(5), createSocket(rows));
+    const checkbox = screen.getByRole('checkbox') as HTMLInputElement;
+    expect(checkbox.checked).toBe(false);
+    expect(checkbox.indeterminate).toBe(true);
+
+    await userEvent.click(checkbox);
+    await waitFor(() => expect(selection.getItems()).toHaveLength(5));
+    expect(checkbox.indeterminate).toBe(false);
+  });
+
+  it('is disabled when the view is empty', () => {
+    const selection = new TableSelectionStore<Item>();
+    renderHeader(selection, createViewStore(0), createSocket([]));
+    expect((screen.getByRole('checkbox') as HTMLInputElement).disabled).toBe(true);
+  });
+
+  it('follows row count changes of the view', () => {
+    const rows = createRows(3);
+    const selection = new TableSelectionStore<Item>();
+    selection.setManySelected(rows);
+
+    const viewStore = createViewStore(3);
+    renderHeader(selection, viewStore, createSocket(rows));
+    const checkbox = screen.getByRole('checkbox') as HTMLInputElement;
+    expect(checkbox.checked).toBe(true);
+
+    // New items arrive
+    viewStore.rowCount = 4;
+    act(() => viewStore.notify());
+    expect(checkbox.checked).toBe(false);
+    expect(checkbox.indeterminate).toBe(true);
+  });
+
+  it('discards the result when the selection is cleared while fetching', async () => {
+    const rows = createRows(150);
+    const selection = new TableSelectionStore<Item>();
+
+    let release: () => void = () => {};
+    const gate = new Promise<void>((resolve) => (release = resolve));
+    const socket = {
+      get: vi.fn(async (url: string) => {
+        await gate;
+        const [, , , , start, end] = url.split('/');
+        return rows.slice(Number(start), Number(end));
+      }),
+    };
+
+    renderHeader(selection, createViewStore(150), socket as any);
+    await userEvent.click(screen.getByRole('checkbox'));
+    expect(socket.get).toHaveBeenCalledTimes(1);
+
+    // E.g. directory changed
+    act(() => selection.clear());
+    release();
+
+    await waitFor(() =>
+      expect((screen.getByRole('checkbox') as HTMLInputElement).disabled).toBe(false),
+    );
+    expect(selection.getItems()).toEqual([]);
+    expect(socket.get).toHaveBeenCalledTimes(1); // No further chunks were requested
+  });
+});
