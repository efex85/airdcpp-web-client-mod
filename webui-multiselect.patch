+import * as React from 'react';
+import { useTranslation } from 'react-i18next';
+import { Cell, CellProps } from 'fixed-data-table-2';
+
+import NotificationActions from '@/actions/NotificationActions';
+import { useSocket } from '@/context/SocketContext';
+import { translate } from '@/utils/TranslationUtils';
+import * as UI from '@/types/ui';
+
+import { TableSelectionItem } from './TableSelectionStore';
+import { useSelectedItems, useTableSelectionStore } from './TableSelectionContext';
+
+import './style.css';
+
+// Rows are requested in chunks to avoid very large API responses
+const ROWS_PER_REQUEST = 100;
+
+// The parts of a table view store (ViewStoreMixin) that are needed for fetching the rows
+export interface SelectableViewStore {
+  // Number of rows matching the current filter
+  rowCount: number;
+  viewUrl: string;
+  listen: (listener: () => void) => () => void;
+}
+
+export interface SelectAllHeaderCellProps extends CellProps {
+  viewStore: SelectableViewStore;
+  columnKey?: string; // CLONED by the table
+}
+
+// Header cell with a checkbox for selecting/deselecting all rows of the table view.
+// The rows are fetched from the API as most of them are not loaded in the table.
+// Only the rows matching the current filter are selected.
+export const SelectAllHeaderCell = ({
+  viewStore,
+  columnKey,
+  ...cellProps
+}: SelectAllHeaderCellProps) => {
+  const { t } = useTranslation();
+  const socket = useSocket();
+  const selection = useTableSelectionStore<TableSelectionItem>();
+  const selectedCount = useSelectedItems().length;
+  const [loading, setLoading] = React.useState(false);
+
+  // The view store isn't reactive, subscribe to count changes (filtering, new items...)
+  const subscribe = React.useCallback(
+    (listener: () => void) => viewStore.listen(listener),
+    [viewStore],
+  );
+  const rowCount = React.useSyncExternalStore(subscribe, () => viewStore.rowCount);
+
+  const allSelected = rowCount > 0 && selectedCount >= rowCount;
+  const partiallySelected = selectedCount > 0 && !allSelected;
+
+  const inputRef = React.useRef<HTMLInputElement>(null);
+  React.useEffect(() => {
+    if (inputRef.current) {
+      inputRef.current.indeterminate = partiallySelected;
+    }
+  }, [partiallySelected]);
+
+  const selectAll = async () => {
+    const generation = selection.getGeneration();
+    const total = viewStore.rowCount;
+
+    setLoading(true);
+    try {
+      const items: TableSelectionItem[] = [];
+      for (let start = 0; start < total; start += ROWS_PER_REQUEST) {
+        const end = Math.min(start + ROWS_PER_REQUEST, total);
+        const rows: TableSelectionItem[] = await socket.get(
+          `${viewStore.viewUrl}/items/${start}/${end}`,
+        );
+
+        if (selection.getGeneration() !== generation) {
+          // The selection was cleared (or the directory was changed) while fetching
+          return;
+        }
+
+        items.push(...rows);
+      }
+
+      selection.setManySelected(items);
+    } catch (e) {
+      NotificationActions.apiError(
+        translate('Failed to select all items', t, UI.Modules.COMMON),
+        e as Error,
+      );
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const onChange = () => {
+    if (allSelected) {
+      selection.clear();
+    } else {
+      void selectAll();
+    }
+  };
+
+  return (
+    <Cell {...cellProps}>
+      <div className="table-select-all">
+        <input
+          ref={inputRef}
+          type="checkbox"
+          className="table-select-checkbox"
+          checked={allSelected}
+          disabled={loading || rowCount === 0}
+          aria-label={translate('Select all', t, UI.Modules.COMMON)}
+          onChange={onChange}
+        />
+      </div>
+    </Cell>
+  );
+};
