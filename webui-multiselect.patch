+import * as React from 'react';
+import { beforeAll, describe, expect, it, vi } from 'vitest';
+import i18n from 'i18next';
+import { initReactI18next } from 'react-i18next';
+import { renderHook, waitFor } from '@testing-library/react';
+import { MemoryRouter, Route, Routes, useLocation } from 'react-router';
+
+import * as API from '@/types/api';
+import * as UI from '@/types/ui';
+import { TableSelectionStore } from '@/components/table/selection';
+
+import { SocketContext } from '@/context/SocketContext';
+import { APISocket } from '@/services/SocketService';
+
+import { useBulkDownload } from '../useBulkDownload';
+
+const createItem = (id: number, name: string, size: number): API.FilelistItem => ({
+  id,
+  name,
+  path: `/${name}`,
+  tth: `tth${id}`,
+  dupe: null,
+  time: 0,
+  size,
+  complete: true,
+  type: { id: 'file', str: 'File', content_type: 'video' as API.FileContentType },
+});
+
+const setup = () => {
+  const selection = new TableSelectionStore<API.FilelistItem>();
+  selection.setManySelected([createItem(1, 'a', 100), createItem(2, 'b', 200)]);
+
+  const itemDataGetter = vi.fn(async (id: string | number) =>
+    createItem(Number(id), 'x', 1),
+  );
+  const downloadHandler: UI.DownloadHandler<API.FilelistItem> = vi.fn();
+
+  let location: ReturnType<typeof useLocation> | undefined;
+  const LocationProbe = () => {
+    location = useLocation();
+    return null;
+  };
+
+  const socket = {} as APISocket;
+  const entity = { id: 'session1' } as UI.SessionItemBase;
+
+  const wrapper = ({ children }: React.PropsWithChildren) => (
+    <SocketContext value={socket}>
+      <MemoryRouter initialEntries={['/session']}>
+        <LocationProbe />
+        <Routes>
+          <Route path="/session/*" element={<>{children}</>} />
+        </Routes>
+      </MemoryRouter>
+    </SocketContext>
+  );
+
+  const hook = renderHook(
+    () => useBulkDownload({ selection, downloadHandler, itemDataGetter, entity }),
+    { wrapper },
+  );
+
+  return {
+    hook,
+    selection,
+    itemDataGetter,
+    downloadHandler,
+    socket,
+    entity,
+    getLocation: () => location!,
+  };
+};
+
+describe('useBulkDownload', () => {
+  beforeAll(async () => {
+    // Used for the interpolation of the default texts
+    await i18n.use(initReactI18next).init({
+      lng: 'en',
+      resources: {},
+      interpolation: { escapeValue: false },
+    });
+  });
+
+  it('returns a placeholder item for the bulk route ID', async () => {
+    const { hook, itemDataGetter } = setup();
+
+    const item = await hook.result.current.itemDataGetter('bulk', {} as any);
+    expect(item.name).toBe('2 items');
+    expect(item.size).toBe(300);
+    expect(itemDataGetter).not.toHaveBeenCalled();
+  });
+
+  it('delegates other item IDs to the original getter', async () => {
+    const { hook, itemDataGetter } = setup();
+
+    const item = await hook.result.current.itemDataGetter('5', {} as any);
+    expect(item.id).toBe(5);
+    expect(itemDataGetter).toHaveBeenCalledWith('5', {});
+  });
+
+  it('opens the download dialog route', async () => {
+    const { hook, getLocation } = setup();
+
+    hook.result.current.startDownloadTo();
+    await waitFor(() => expect(getLocation().pathname).toBe('/session/download/bulk'));
+  });
+
+  it('downloads the selected items without opening the dialog or setting a directory', async () => {
+    const { hook, selection, downloadHandler, socket, entity, getLocation } = setup();
+
+    await hook.result.current.startDownload();
+
+    expect(downloadHandler).toHaveBeenCalledTimes(2);
+    const calls = vi.mocked(downloadHandler).mock.calls;
+    expect(calls.map(([data]) => data.itemInfo.name)).toEqual(['a', 'b']);
+    calls.forEach(([data, downloadData, callSocket], index) => {
+      expect(data.entity).toBe(entity);
+      expect(callSocket).toBe(socket);
+      expect(downloadData.target_name).toBe(['a', 'b'][index]);
+      expect(downloadData).not.toHaveProperty('target_directory');
+    });
+
+    expect(selection.getItems()).toEqual([]);
+    expect(getLocation().pathname).toBe('/session');
+  });
+
+  it('keeps the items that failed to download selected', async () => {
+    const { hook, selection, downloadHandler } = setup();
+    vi.mocked(downloadHandler).mockImplementation(async ({ itemInfo }) => {
+      if (itemInfo.name === 'a') {
+        throw new Error('failed');
+      }
+    });
+
+    await hook.result.current.startDownload();
+
+    expect(selection.getItems().map((item) => item.name)).toEqual(['a']);
+  });
+});
