+import { describe, expect, it } from 'vitest';
+import { act, renderHook } from '@testing-library/react';
+
+import { useTableSelection } from '../useTableSelection';
+
+interface Item {
+  id: number;
+}
+
+describe('useTableSelection', () => {
+  it('keeps the same store and selection while the reset key is unchanged', () => {
+    const { result, rerender } = renderHook(
+      ({ resetKey }) => useTableSelection<Item>(resetKey),
+      { initialProps: { resetKey: 'a' } },
+    );
+
+    const store = result.current;
+    act(() => store.setSelected({ id: 1 }, true));
+
+    rerender({ resetKey: 'a' });
+    expect(result.current).toBe(store);
+    expect(store.getItems()).toEqual([{ id: 1 }]);
+  });
+
+  it('clears the selection when the reset key changes', () => {
+    const { result, rerender } = renderHook(
+      ({ resetKey }) => useTableSelection<Item>(resetKey),
+      { initialProps: { resetKey: 'a' } },
+    );
+
+    const store = result.current;
+    act(() => store.setSelected({ id: 1 }, true));
+
+    rerender({ resetKey: 'b' });
+    expect(result.current).toBe(store);
+    expect(store.getItems()).toEqual([]);
+  });
+});
