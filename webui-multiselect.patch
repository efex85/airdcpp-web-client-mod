+import * as API from '@/types/api';
+import * as UI from '@/types/ui';
+
+import { TableSelectionStore } from '@/components/table/selection';
+
+// The download dialog is opened with an item ID in the route (download/:id).
+// For bulk downloads, this reserved ID is used instead of a real item ID.
+export const BULK_DOWNLOAD_ITEM_ID = 'bulk';
+
+export const isBulkDownloadRouteId = (itemId: API.IdType) =>
+  String(itemId) === BULK_DOWNLOAD_ITEM_ID;
+
+// The dialog receives the placeholder item (not the route ID) from the item getter.
+// Real paths always start with a slash so this can't match a real item.
+const BULK_PLACEHOLDER_PATH = '<bulk>';
+
+export const isBulkDownloadPlaceholder = (item: Pick<UI.DownloadableItemInfo, 'path'>) =>
+  item.path === BULK_PLACEHOLDER_PATH;
+
+// Placeholder item for the download dialog (it's used only for displaying the dialog).
+// Only the fields of DownloadableItemInfo are filled; other fields that the item type
+// may have are never read for the placeholder (the bulk handler replaces it with the real items).
+export const createBulkDownloadItem = <ItemT extends UI.DownloadableItemInfo>(
+  items: UI.DownloadableItemInfo[],
+  name: string,
+): ItemT => {
+  const placeholder: UI.DownloadableItemInfo = {
+    id: -1,
+    name,
+    path: BULK_PLACEHOLDER_PATH,
+    tth: '',
+    dupe: null,
+    time: 0,
+    size: items.reduce((total, item) => total + item.size, 0),
+    type: {
+      id: 'directory',
+      str: 'Directory',
+      files: items.filter((item) => item.type.id === 'file').length,
+      directories: items.filter((item) => item.type.id === 'directory').length,
+    },
+  };
+
+  return placeholder as ItemT;
+};
+
+// Wraps the regular download handler so that the placeholder item queues all selected items
+// to the chosen target directory. Items that were queued successfully are removed
+// from the selection, so that a failed download can be retried without duplicates.
+export const createBulkDownloadHandler = <ItemT extends UI.DownloadableItemInfo>(
+  selection: TableSelectionStore<ItemT>,
+  downloadHandler: UI.DownloadHandler<ItemT>,
+): UI.DownloadHandler<ItemT> => {
+  return async (itemData, downloadData, socket) => {
+    if (!isBulkDownloadPlaceholder(itemData.itemInfo)) {
+      return downloadHandler(itemData, downloadData, socket);
+    }
+
+    const items = selection.getItems();
+    const failures: { item: ItemT; error: Error }[] = [];
+
+    for (const item of items) {
+      try {
+        await downloadHandler(
+          { ...itemData, itemInfo: item },
+          // Each item needs its own name (the shared name belongs to the placeholder)
+          { ...downloadData, target_name: item.name },
+          socket,
+        );
+
+        selection.setSelected(item, false);
+      } catch (e) {
+        failures.push({ item, error: e as Error });
+      }
+    }
+
+    if (failures.length > 0) {
+      const names = failures.map(({ item }) => item.name).join(', ');
+      throw new Error(
+        `Failed to queue ${failures.length}/${items.length} items (${names}): ${failures[0].error.message}`,
+      );
+    }
+  };
+};
diff --git a/src/components/download/bulk/__tests__/BulkDownload.node.test.ts b/src/components/download/bulk/__tests__/BulkDownload.node.test.ts
