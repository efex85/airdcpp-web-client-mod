@@ -0,0 +1,84 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import { TableSelectionStore } from '../TableSelectionStore';
+
+interface Item {
+  id: number;
+  name: string;
+}
+
+const itemA: Item = { id: 1, name: 'a' };
+const itemB: Item = { id: 2, name: 'b' };
+
+describe('TableSelectionStore', () => {
+  it('selects and deselects items', () => {
+    const store = new TableSelectionStore<Item>();
+
+    store.setSelected(itemA, true);
+    store.setSelected(itemB, true);
+    expect(store.isSelected(1)).toBe(true);
+    expect(store.getItems()).toEqual([itemA, itemB]);
+
+    store.setSelected(itemA, false);
+    expect(store.isSelected(1)).toBe(false);
+    expect(store.getItems()).toEqual([itemB]);
+  });
+
+  it('notifies listeners only when the state changes', () => {
+    const store = new TableSelectionStore<Item>();
+    const listener = vi.fn();
+    const unsubscribe = store.subscribe(listener);
+
+    store.setSelected(itemA, true);
+    store.setSelected(itemA, true); // No change
+    store.setSelected(itemB, false); // No change
+    expect(listener).toHaveBeenCalledTimes(1);
+
+    store.clear();
+    store.clear(); // No change
+    expect(listener).toHaveBeenCalledTimes(2);
+
+    unsubscribe();
+    store.setSelected(itemA, true);
+    expect(listener).toHaveBeenCalledTimes(2);
+  });
+
+  it('creates a new snapshot for every change', () => {
+    const store = new TableSelectionStore<Item>();
+    const empty = store.getSnapshot();
+
+    store.setSelected(itemA, true);
+    const withA = store.getSnapshot();
+    expect(withA).not.toBe(empty);
+    expect(empty.size).toBe(0);
+    expect(store.getSnapshot()).toBe(withA);
+  });
+
+  it('adds many items with a single notification', () => {
+    const store = new TableSelectionStore<Item>();
+    store.setSelected(itemA, true);
+    const listener = vi.fn();
+    store.subscribe(listener);
+
+    store.setManySelected([itemA, itemB]);
+    expect(store.getItems()).toEqual([itemA, itemB]);
+    expect(listener).toHaveBeenCalledTimes(1);
+
+    store.setManySelected([itemA, itemB]); // No change
+    expect(listener).toHaveBeenCalledTimes(1);
+  });
+
+  it('increases the generation on every clear', () => {
+    const store = new TableSelectionStore<Item>();
+    const initial = store.getGeneration();
+
+    store.clear(); // Also when nothing is selected
+    expect(store.getGeneration()).toBe(initial + 1);
+
+    store.setSelected(itemA, true);
+    expect(store.getGeneration()).toBe(initial + 1);
+
+    store.clear();
+    expect(store.getGeneration()).toBe(initial + 2);
+  });
+});
