+
+interface QueueActionsMenuProps {
+  queueT: UI.ModuleTranslator;
+}
+
+// The queue actions menu in the table footer. The actions for the selected bundles
+// are added to the same menu while there are selected bundles.
+export const QueueActionsMenu: React.FC<QueueActionsMenuProps> = ({ queueT }) => {
+  const { t } = useTranslation();
+  const selection = useTableSelectionStore<API.QueueBundle>();
+  const bundles = useSelectedItems<API.QueueBundle>();
+
+  const selectionItemData: QueueBundleSelectionData = React.useMemo(
+    () => ({
+      id: 'selection',
+      name: t(toI18nKey('xBundles', UI.Modules.QUEUE), {
+        defaultValue_one: '{{count}} bundle',
+        defaultValue_other: '{{count}} bundles',
+        count: bundles.length,
+        replace: { count: bundles.length },
+      }),
+      bundles,
+      selection,
+    }),
+    [bundles, selection, t],
+  );
+
+  return (
+    <ActionMenu
+      className="top left pointing"
+      caption={queueT.translate('Actions...')}
+      actions={QueueActionMenu}
+      header={queueT.translate('Queue actions')}
+      triggerIcon="chevron up"
+      button={true}
+      remoteMenuId={MenuConstants.QUEUE}
+    >
+      {bundles.length > 0 && (
+        <ActionMenu
+          actions={QueueBundleSelectionActionMenu}
+          itemData={selectionItemData}
+        />
+      )}
+    </ActionMenu>
+  );
+};
