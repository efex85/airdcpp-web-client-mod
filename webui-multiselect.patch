@@ -0,0 +1,132 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import * as API from '@/types/api';
+import * as UI from '@/types/ui';
+import { TableSelectionStore } from '@/components/table/selection';
+
+import {
+  BULK_DOWNLOAD_ITEM_ID,
+  createBulkDownloadHandler,
+  createBulkDownloadItem,
+  isBulkDownloadPlaceholder,
+  isBulkDownloadRouteId,
+} from '../BulkDownload';
+
+const createItem = (
+  id: number,
+  name: string,
+  type: 'file' | 'directory',
+  size = 100,
+): API.FilelistItem => ({
+  id,
+  name,
+  path: `/${name}`,
+  tth: `tth${id}`,
+  dupe: null,
+  time: 0,
+  size,
+  complete: true,
+  type:
+    type === 'file'
+      ? { id: 'file', str: 'File', content_type: 'video' as API.FileContentType }
+      : { id: 'directory', str: 'Directory', files: 0, directories: 0 },
+});
+
+const file1 = createItem(1, 'one.mkv', 'file', 100);
+const file2 = createItem(2, 'two.mkv', 'file', 200);
+const dir = createItem(3, 'folder', 'directory', 300);
+
+const socket = {} as any;
+const entity = undefined;
+const downloadData = {
+  target_name: 'placeholder',
+  target_directory: '/downloads/',
+  priority: API.QueuePriorityEnum.DEFAULT,
+} as API.DownloadData;
+
+const bulkItemData = (items: API.FilelistItem[]) => ({
+  itemInfo: createBulkDownloadItem<API.FilelistItem>(items, `${items.length} items`),
+  user: undefined,
+  entity,
+});
+
+describe('bulk download item', () => {
+  it('detects the reserved route ID', () => {
+    expect(isBulkDownloadRouteId(BULK_DOWNLOAD_ITEM_ID)).toBe(true);
+    expect(isBulkDownloadRouteId(1)).toBe(false);
+    expect(isBulkDownloadRouteId('1')).toBe(false);
+  });
+
+  it('detects the placeholder item but not real items', () => {
+    expect(
+      isBulkDownloadPlaceholder(
+        createBulkDownloadItem<API.FilelistItem>([file1], '1 item'),
+      ),
+    ).toBe(true);
+    [file1, file2, dir].forEach((item) =>
+      expect(isBulkDownloadPlaceholder(item)).toBe(false),
+    );
+  });
+
+  it('summarizes the selected items', () => {
+    const item = createBulkDownloadItem<API.FilelistItem>([file1, file2, dir], '3 items');
+    expect(item.name).toBe('3 items');
+    expect(item.size).toBe(600);
+    expect(item.type).toMatchObject({ id: 'directory', files: 2, directories: 1 });
+  });
+});
+
+describe('bulk download handler', () => {
+  it('passes regular items through to the wrapped handler', async () => {
+    const selection = new TableSelectionStore<API.FilelistItem>();
+    const inner = vi.fn().mockResolvedValue(undefined);
+    const handler = createBulkDownloadHandler(selection, inner);
+
+    const itemData = { itemInfo: file1, user: undefined, entity };
+    await handler(itemData, downloadData, socket);
+
+    expect(inner).toHaveBeenCalledTimes(1);
+    expect(inner).toHaveBeenCalledWith(itemData, downloadData, socket);
+  });
+
+  it('queues every selected item with its own name and clears the selection', async () => {
+    const selection = new TableSelectionStore<API.FilelistItem>();
+    [file1, file2, dir].forEach((item) => selection.setSelected(item, true));
+
+    const inner = vi.fn().mockResolvedValue(undefined);
+    const handler = createBulkDownloadHandler(selection, inner);
+
+    await handler(bulkItemData(selection.getItems()), downloadData, socket);
+
+    expect(inner).toHaveBeenCalledTimes(3);
+    expect(inner.mock.calls.map(([data]) => data.itemInfo)).toEqual([file1, file2, dir]);
+    expect(inner.mock.calls.map(([, dlData]) => dlData.target_name)).toEqual([
+      'one.mkv',
+      'two.mkv',
+      'folder',
+    ]);
+    inner.mock.calls.forEach(([, dlData]) =>
+      expect(dlData.target_directory).toBe('/downloads/'),
+    );
+    expect(selection.getItems()).toEqual([]);
+  });
+
+  it('keeps failed items selected and reports them', async () => {
+    const selection = new TableSelectionStore<API.FilelistItem>();
+    [file1, file2, dir].forEach((item) => selection.setSelected(item, true));
+
+    const inner: UI.DownloadHandler<API.FilelistItem> = vi.fn(async ({ itemInfo }) => {
+      if (itemInfo.id === file2.id) {
+        throw new Error('queue full');
+      }
+    });
+    const handler = createBulkDownloadHandler(selection, inner);
+
+    await expect(
+      handler(bulkItemData(selection.getItems()), downloadData, socket),
+    ).rejects.toThrow('Failed to queue 1/3 items (two.mkv): queue full');
+
+    expect(selection.getItems()).toEqual([file2]);
+    expect(inner).toHaveBeenCalledTimes(3);
+  });
+});
