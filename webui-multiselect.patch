@@ -0,0 +1,17 @@
+import * as React from 'react';
+
+import { TableSelectionItem, TableSelectionStore } from './TableSelectionStore';
+
+// Creates a selection store for a table. The selection is cleared when the reset key
+// changes (e.g. the displayed directory or the search was changed).
+export const useTableSelection = <ItemT extends TableSelectionItem>(
+  resetKey: string | number,
+) => {
+  const store = React.useMemo(() => new TableSelectionStore<ItemT>(), []);
+
+  React.useEffect(() => {
+    store.clear();
+  }, [store, resetKey]);
+
+  return store;
+};
