+import { describe, expect, it, vi } from 'vitest';
+
+import {
+  SearchSelectionData,
+  SearchSelectionDownloadAction,
+  SearchSelectionDownloadToAction,
+} from '../SearchSelectionActions';
+
+const createData = (): SearchSelectionData => ({
+  id: 'selection',
+  name: '2 results',
+  download: vi.fn(async () => undefined),
+  downloadTo: vi.fn(),
+});
+
+const run = (
+  action: typeof SearchSelectionDownloadAction,
+  itemData: SearchSelectionData,
+) =>
+  action.handler({
+    itemData,
+    entity: undefined,
+    socket: {},
+  } as unknown as Parameters<typeof action.handler>[0]);
+
+describe('SearchSelectionActions', () => {
+  it('downloads the selection to the default directory', async () => {
+    const data = createData();
+    await run(SearchSelectionDownloadAction, data);
+
+    expect(data.download).toHaveBeenCalledTimes(1);
+    expect(data.downloadTo).not.toHaveBeenCalled();
+  });
+
+  it('opens the directory selection', async () => {
+    const data = createData();
+    await run(
+      SearchSelectionDownloadToAction as typeof SearchSelectionDownloadAction,
+      data,
+    );
+
+    expect(data.downloadTo).toHaveBeenCalledTimes(1);
+    expect(data.download).not.toHaveBeenCalled();
+  });
+});
