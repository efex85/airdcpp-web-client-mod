+import * as React from 'react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { act, cleanup, render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+
+import { SelectCell } from '../SelectCell';
+import { SelectionBar } from '../SelectionBar';
+import { TableSelectionProvider } from '../TableSelectionContext';
+import { TableSelectionStore } from '../TableSelectionStore';
+
+interface Item {
+  id: number;
+  name: string;
+}
+
+const itemA: Item = { id: 1, name: 'first.txt' };
+const itemB: Item = { id: 2, name: 'second.txt' };
+
+const renderCell = (store: TableSelectionStore<Item>, item: Item) =>
+  render(
+    <TableSelectionProvider store={store}>
+      <SelectCell<Item> rowDataGetter={() => item} />
+    </TableSelectionProvider>,
+  );
+
+afterEach(() => cleanup());
+
+describe('SelectCell', () => {
+  it('selects and deselects the row when clicked', async () => {
+    const store = new TableSelectionStore<Item>();
+    renderCell(store, itemA);
+
+    const checkbox = screen.getByRole('checkbox') as HTMLInputElement;
+    expect(checkbox.checked).toBe(false);
+
+    await userEvent.click(checkbox);
+    expect(store.getItems()).toEqual([itemA]);
+    expect(checkbox.checked).toBe(true);
+
+    await userEvent.click(checkbox);
+    expect(store.getItems()).toEqual([]);
+    expect(checkbox.checked).toBe(false);
+  });
+
+  it('reflects selection changes made outside of the cell', () => {
+    const store = new TableSelectionStore<Item>();
+    renderCell(store, itemA);
+    const checkbox = screen.getByRole('checkbox') as HTMLInputElement;
+
+    act(() => store.setSelected(itemA, true));
+    expect(checkbox.checked).toBe(true);
+
+    act(() => store.clear());
+    expect(checkbox.checked).toBe(false);
+  });
+
+  it('follows the row when the cell is recycled for another item', () => {
+    const store = new TableSelectionStore<Item>();
+    store.setSelected(itemB, true);
+
+    const { rerender } = renderCell(store, itemA);
+    const checkbox = screen.getByRole('checkbox') as HTMLInputElement;
+    expect(checkbox.checked).toBe(false);
+
+    rerender(
+      <TableSelectionProvider store={store}>
+        <SelectCell<Item> rowDataGetter={() => itemB} />
+      </TableSelectionProvider>,
+    );
+    expect(checkbox.checked).toBe(true);
+  });
+});
+
+describe('SelectionBar', () => {
+  it('is hidden when nothing is selected', () => {
+    const store = new TableSelectionStore<Item>();
+    const { container } = render(
+      <TableSelectionProvider store={store}>
+        <SelectionBar onDownload={vi.fn()} />
+      </TableSelectionProvider>,
+    );
+
+    expect(container.querySelector('.table-selection-bar')).toBeNull();
+  });
+
+  it('shows the actions for selected items', async () => {
+    const store = new TableSelectionStore<Item>();
+    const onDownload = vi.fn();
+    const { container } = render(
+      <TableSelectionProvider store={store}>
+        <SelectionBar onDownload={onDownload} />
+      </TableSelectionProvider>,
+    );
+
+    act(() => {
+      store.setSelected(itemA, true);
+      store.setSelected(itemB, true);
+    });
+
+    expect(container.querySelector('.table-selection-bar')).not.toBeNull();
+    const buttons = screen.getAllByRole('button');
+    expect(buttons).toHaveLength(2);
+
+    await userEvent.click(buttons[0]);
+    expect(onDownload).toHaveBeenCalledTimes(1);
+
+    await userEvent.click(buttons[1]);
+    expect(store.getItems()).toEqual([]);
+    expect(container.querySelector('.table-selection-bar')).toBeNull();
+  });
+});
diff --git a/src/components/table/selection/__tests__/TableSelectionStore.node.test.ts b/src/components/table/selection/__tests__/TableSelectionStore.node.test.ts
