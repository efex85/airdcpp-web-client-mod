+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { waitFor, within } from '@testing-library/react';
+
+import { renderDataRoutes } from '@/tests/render/test-renderers';
+import { initCommonDataMocks } from '@/tests/mocks/mock-data-common';
+import { getMockServer, MockServer } from '@/tests/mocks/mock-server';
+import { installTableMocks } from '@/tests/mocks/mock-table';
+import { setupUserEvent } from '@/tests/helpers/test-form-helpers';
+import { clickMenuItem, openMenu } from '@/tests/helpers/test-menu-helpers';
+import { navigateToUrl, parseMockRequest } from '@/tests/helpers/test-helpers';
+
+import QueueConstants from '@/constants/QueueConstants';
+import Queue from '../components/Queue';
+import { QueueBundlesListResponse } from '@/tests/mocks/api/queue-bundles';
+import { QueueFilesListResponse } from '@/tests/mocks/api/queue-files';
+
+const [Bundle1, Bundle2] = QueueBundlesListResponse;
+
+describe('Queue selection', () => {
+  let server: MockServer;
+
+  beforeEach(() => {
+    server = getMockServer();
+  });
+
+  afterEach(() => {
+    server.stop();
+  });
+
+  const renderLayout = async () => {
+    const commonData = await initCommonDataMocks(server);
+
+    const bundleTableMocks = installTableMocks(QueueBundlesListResponse, {
+      server,
+      moduleUrl: QueueConstants.MODULE_URL,
+      viewName: QueueConstants.BUNDLE_VIEW_ID,
+    });
+
+    // Select all fetches all rows of the view at once (the default mocks support only up to 10 rows)
+    server.addRequestHandler(
+      'GET',
+      `queue/${QueueConstants.BUNDLE_VIEW_ID}_view/items/0/${QueueBundlesListResponse.length}`,
+      bundleTableMocks.mockTableManager.getItems(0, QueueBundlesListResponse.length),
+    );
+
+    installTableMocks(QueueFilesListResponse, {
+      server,
+      moduleUrl: QueueConstants.MODULE_URL,
+      viewName: QueueConstants.FILE_VIEW_ID,
+    });
+
+    const onRemove = vi.fn();
+    const onPriority = vi.fn();
+    QueueBundlesListResponse.forEach((bundle) => {
+      server.addRequestHandler(
+        'POST',
+        `queue/bundles/${bundle.id}/remove`,
+        undefined,
+        onRemove,
+      );
+      server.addRequestHandler(
+        'POST',
+        `queue/bundles/${bundle.id}/priority`,
+        undefined,
+        onPriority,
+      );
+    });
+
+    const routes = [
+      {
+        index: true,
+        Component: () => <div>Index page</div>,
+      },
+      {
+        path: '/queue/*',
+        Component: () => <Queue />,
+      },
+    ];
+
+    const renderData = renderDataRoutes(routes, commonData, {
+      routerProps: { initialEntries: ['/queue'] },
+    });
+
+    const userEvent = setupUserEvent();
+    const renderResult = { ...commonData, ...renderData, userEvent };
+
+    await waitFor(() => expect(renderResult.getByRole('grid')).toBeTruthy());
+    await waitFor(() => expect(renderResult.queryByText(Bundle1.name)).toBeTruthy());
+
+    return { ...renderResult, bundleTableMocks, onRemove, onPriority };
+  };
+
+  const requestsOf = (mock: ReturnType<typeof vi.fn>) =>
+    mock.mock.calls.map(([request]) => parseMockRequest(request));
+
+  test('should select and deselect a bundle', async () => {
+    const { getByRole, getByText, queryByText, userEvent, router } = await renderLayout();
+
+    // Nothing selected
+    expect(queryByText(/selected$/)).toBeNull();
+
+    const checkbox = getByRole('checkbox', { name: `Select ${Bundle1.name}` });
+    await userEvent.click(checkbox);
+
+    await waitFor(() => expect(getByText('1 selected')).toBeTruthy());
+    expect((checkbox as HTMLInputElement).checked).toBe(true);
+
+    await userEvent.click(checkbox);
+    await waitFor(() => expect(queryByText('1 selected')).toBeNull());
+
+    await navigateToUrl('/', router);
+  });
+
+  test('should select and clear all bundles with the header checkbox', async () => {
+    const { getByRole, getByText, queryByText, userEvent, router } = await renderLayout();
+
+    const total = QueueBundlesListResponse.length;
+    const selectAll = getByRole('checkbox', { name: 'Select all' }) as HTMLInputElement;
+    await userEvent.click(selectAll);
+
+    await waitFor(() => expect(getByText(`${total} selected`)).toBeTruthy());
+    expect(selectAll.checked).toBe(true);
+
+    // Everything is selected, the next click clears the selection
+    await userEvent.click(selectAll);
+    await waitFor(() => expect(queryByText(`${total} selected`)).toBeNull());
+    expect(selectAll.checked).toBe(false);
+
+    await navigateToUrl('/', router);
+  });
+
+  test('should show the partial selection state', async () => {
+    const { getByRole, userEvent, router } = await renderLayout();
+
+    await userEvent.click(getByRole('checkbox', { name: `Select ${Bundle1.name}` }));
+
+    const selectAll = getByRole('checkbox', { name: 'Select all' }) as HTMLInputElement;
+    await waitFor(() => expect(selectAll.indeterminate).toBe(true));
+    expect(selectAll.checked).toBe(false);
+
+    await navigateToUrl('/', router);
+  });
+
+  test('should not show the selected bundle actions without a selection', async () => {
+    const renderResult = await renderLayout();
+    const { findByRole, queryByRole, router } = renderResult;
+
+    await openMenu('Actions...', renderResult);
+    expect(await findByRole('menuitem', { name: 'Pause all bundles' })).toBeTruthy();
+    expect(queryByRole('menuitem', { name: 'Remove selected bundles' })).toBeNull();
+
+    await navigateToUrl('/', router);
+  });
+
+  test('should show the selected bundle actions in the actions menu', async () => {
+    const renderResult = await renderLayout();
+    const { findByRole, getByRole, userEvent, router } = renderResult;
+
+    await userEvent.click(getByRole('checkbox', { name: `Select ${Bundle1.name}` }));
+    await openMenu('Actions...', renderResult);
+
+    // Both the general and the selection actions are in the same menu
+    expect(await findByRole('menuitem', { name: 'Pause all bundles' })).toBeTruthy();
+    expect(
+      await findByRole('menuitem', { name: 'Remove selected bundles' }),
+    ).toBeTruthy();
+
+    await navigateToUrl('/', router);
+  });
+
+  test('should remove the selected bundles', async () => {
+    const renderResult = await renderLayout();
+    const { getByRole, queryByText, userEvent, onRemove, router } = renderResult;
